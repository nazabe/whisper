WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_HOTWORDS="Android Kotlin Java WebView APK HTML CSS JavaScript manifest Activity Service"
WHISPER_CPU_THREADS=0
WHISPER_MAX_CONCURRENCY=1
WHISPER_QUEUE_TIMEOUT_SEC=30
WHISPER_MAX_UPLOAD_MB=100
WHISPER_LOG_LEVEL=INFO

# Optional: keep the model outside the default HuggingFace cache.
# WHISPER_MODEL_CACHE_DIR=/models
